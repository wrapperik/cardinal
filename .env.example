# Copy to .env.local and fill from the Firebase console:
# Project settings > General > Your apps > Web app > SDK setup and configuration
#
# EXPO_PUBLIC_ vars are inlined into the JS bundle. That is correct for Firebase
# web config (it is not a secret), but it means Firestore Security Rules are the
# only thing protecting your data. Write them before going live.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Model API keys must never use the EXPO_PUBLIC_ prefix. Groq extraction runs
# inside Firebase Functions, where GROQ_API_KEY will be stored as a server-side
# secret. Until that function is connected, uploads use the bundled mock.
