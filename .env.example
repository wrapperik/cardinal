# Copy to .env.local and fill from the Firebase console:
# Project settings > General > Your apps > Web app > SDK setup and configuration
#
# EXPO_PUBLIC_ vars are inlined into the JS bundle. That is correct for Firebase
# web config (it is not a secret), but it means Firestore Security Rules are the
# only thing protecting your data. Write them before going live.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Authentication > Sign-in method > Google, plus Google Cloud OAuth clients.
# The web client ID is used to mint the ID token Firebase accepts.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# The reversed iOS client ID, e.g. com.googleusercontent.apps.123-abc.
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# Upload extraction. Leaving both of these unset is a supported state, not a
# broken one: the upload flow falls back to a mock extractor that fabricates
# cards from the app's own sample data, so the whole pick-extract-review-save
# pipeline demos with zero API keys configured.
#
# https://aistudio.google.com/apikey — free tier. Reads PDFs directly, which
# is why it is tried first.
EXPO_PUBLIC_GEMINI_API_KEY=
# https://console.groq.com/keys — free tier. Text and markdown only: Groq's
# chat models have no way to read a PDF's binary layout, so a PDF pick with
# only this key set is rejected rather than silently sent as garbage.
EXPO_PUBLIC_GROQ_API_KEY=
