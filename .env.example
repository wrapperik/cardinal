# Copy to .env.local and fill from the Firebase console:
# Project settings > General > Your apps > Web app > SDK setup and configuration
#
# EXPO_PUBLIC_ vars are inlined into the JS bundle. That is correct for Firebase
# web config (it is not a secret), but it means Firestore Security Rules are the
# only thing protecting your data. Write them before going live.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Model API keys must never use the EXPO_PUBLIC_ prefix. Gemini extraction runs
# inside Firebase Functions, where GEMINI_API_KEY is stored as a server-side
# secret. Set this non-secret feature flag to 1 only after the Function is
# deployed; until then, uploads use the bundled mock.
EXPO_PUBLIC_ENABLE_GEMINI_EXTRACTION=

# Set to point the app at the local Firebase emulator suite (`npm run
# emulators`) instead of the bobs-b1bd8 project, so backend work never
# touches production data. `npm run start:emulator` sets this for you.
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=

# Host the emulators are reachable on. Leave unset to use the per-platform
# default (localhost, or 10.0.2.2 on the Android emulator, whose loopback
# is not the host machine's). Set this only for a physical device on the
# same LAN, to your machine's LAN IP.
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=

# Comma-separated allowlist of admin dashboard emails, read by the
# syncAdminRole Cloud Function. Lives in functions/.env, not here — it is
# server-side config with no EXPO_PUBLIC_ prefix, so it never reaches the
# client bundle. Being on this list is what syncAdminRole checks before it
# grants the admin custom claim; it is not itself the grant.
# ADMIN_EMAILS=
