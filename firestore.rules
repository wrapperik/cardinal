rules_version = '2';

/**
 * Cardinal — Firestore security rules.
 *
 * Enforces the model in docs/erd.md. The TypeScript shapes in
 * src/types/cardinal.ts are advisory: they describe what the client intends to
 * write. This file is the only thing that decides what it is allowed to.
 *
 * The backbone is ownership. Every root document carries `ownerId`, and every
 * user subcollection is keyed by the uid in its path, so "is this yours" is
 * answerable without a lookup — with one exception, `decks/{deckId}/cards`,
 * noted where it appears.
 *
 * Two groups of fields are deliberately unwritable by the client, because the
 * ERD assigns them to a Cloud Function trigger. The Admin SDK bypasses rules
 * entirely, so denying them here costs the backend nothing:
 *
 *   - everything under users/{userId}/stats
 *   - the streak fields on the user document
 *   - the outcome fields on an upload job (status, deckId, cardsGenerated, …)
 *
 * That last one is the reason a client cannot mint itself a finished upload
 * pointing at someone else's deck.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------------------------------------------------------------- */
    /* Helpers                                                           */
    /* ---------------------------------------------------------------- */

    function signedIn() {
      return request.auth != null;
    }

    /** True when the path's userId segment is the caller's own uid. */
    function isUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    /** The document as it will exist after the write. Null on delete. */
    function incoming() {
      return request.resource.data;
    }

    /** The document as it exists now. Null on create. */
    function existing() {
      return resource.data;
    }

    /**
     * Ownership of a root document. Takes the data map rather than reading
     * `resource` directly so it works against both the stored document and the
     * incoming one — an update has to satisfy both, or a user could hand their
     * deck to someone else by rewriting ownerId.
     */
    function owns(data) {
      return signedIn() && data.ownerId == request.auth.uid;
    }

    function unchanged(field) {
      return incoming()[field] == existing()[field];
    }

    /**
     * The four templates. These strings are persisted in saved decks and read
     * by the extraction parser and all four game screens, so an unknown value
     * is a card no screen can render.
     */
    function isGameType(value) {
      return value in ['compassQuiz', 'trueFalseDuel', 'sequenceSwipe', 'matchRelease'];
    }

    /** serverTimestamp() resolves to request.time, so this pins it to now. */
    function isServerTime(field) {
      return incoming()[field] == request.time;
    }

    /* ---------------------------------------------------------------- */
    /* users/{userId}                                                    */
    /* ---------------------------------------------------------------- */

    match /users/{userId} {
      // No `list`: nothing queries the users collection, and allowing it would
      // expose every email address in the project to any signed-in caller.
      allow get: if isUser(userId);

      // Written once, by createUserDocument() in features/auth/service.ts. The
      // zeroed streaks are enforced rather than trusted so a fresh account
      // cannot be created already several days deep.
      allow create: if isUser(userId)
                    && incoming().userId == userId
                    && incoming().email is string
                    && incoming().displayName is string
                    && incoming().onboardingComplete is bool
                    && incoming().currentStreak == 0
                    && incoming().longestStreak == 0
                    && incoming().lastStudiedDate == null
                    && isServerTime('createdAt');

      // The client owns its profile; the session trigger owns the streaks.
      allow update: if isUser(userId)
                    && unchanged('userId')
                    && unchanged('createdAt')
                    && unchanged('currentStreak')
                    && unchanged('longestStreak')
                    && unchanged('lastStudiedDate');

      // Deleting the document would strand the subcollections beneath it,
      // which Firestore does not cascade. Account deletion belongs to a
      // function that can clean up first.
      allow delete: if false;
    }

    /* users/{userId}/stats/summary — derived, never client-written. */
    match /users/{userId}/stats/{docId} {
      allow read: if isUser(userId);
      allow write: if false;
    }

    /* users/{userId}/preferences/settings */
    match /users/{userId}/preferences/{docId} {
      allow read: if isUser(userId);

      // The ERD fixes the document id, so a second preferences document is a
      // bug rather than a feature.
      allow write: if isUser(userId)
                   && docId == 'settings'
                   && incoming().keys().hasOnly([
                        'userId',
                        'accessibilityTapZones',
                        'hapticsEnabled',
                        'dailyReminderEnabled',
                        'reminderTime',
                        'theme'
                      ])
                   && incoming().userId == userId
                   && incoming().accessibilityTapZones is bool
                   && incoming().hapticsEnabled is bool
                   && incoming().dailyReminderEnabled is bool
                   && incoming().theme is string
                   // "HH:MM", 24-hour local.
                   && incoming().reminderTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    /* users/{userId}/progress/{cardId} — SM-2 scheduling state. */
    match /users/{userId}/progress/{cardId} {
      allow read: if isUser(userId);

      allow create, update: if isUser(userId)
                            && incoming().cardId == cardId
                            && incoming().deckId is string
                            // SM-2's ease factor has a hard floor of 1.3.
                            && incoming().easeFactor >= 1.3
                            && incoming().interval >= 0
                            && incoming().repetitions >= 0
                            && incoming().lapses >= 0
                            && incoming().lastQuality >= 0
                            && incoming().lastQuality <= 5
                            && incoming().dueDate is timestamp
                            && incoming().lastReviewedAt is timestamp;

      // Resetting a card's schedule is a legitimate thing to want.
      allow delete: if isUser(userId);
    }

    /* users/{userId}/sessions/{sessionId} */
    match /users/{userId}/sessions/{sessionId} {
      allow read: if isUser(userId);

      // A session opens empty and open-ended; the counters accrue as it runs.
      allow create: if isUser(userId)
                    && incoming().sessionId == sessionId
                    && incoming().deckId is string
                    && isServerTime('startedAt')
                    && incoming().endedAt == null
                    && incoming().correctCount == 0
                    && incoming().wrongCount == 0
                    && incoming().passedCount == 0
                    && incoming().bestStreakInSession == 0
                    && incoming().gameTypesPlayed is list;

      // Counters only ever climb. Without this a client could close a session
      // it opened honestly and rewrite the totals the stats trigger reads.
      allow update: if isUser(userId)
                    && unchanged('sessionId')
                    && unchanged('deckId')
                    && unchanged('startedAt')
                    && incoming().correctCount >= existing().correctCount
                    && incoming().wrongCount >= existing().wrongCount
                    && incoming().passedCount >= existing().passedCount
                    && incoming().bestStreakInSession >= existing().bestStreakInSession
                    // Once closed, a session stays closed.
                    && existing().endedAt == null;

      allow delete: if isUser(userId);
    }

    /* ---------------------------------------------------------------- */
    /* courses/{courseId}                                                */
    /* ---------------------------------------------------------------- */

    /**
     * Root-level, per the ERD, so a course can later be shared without the
     * documents moving. Until it can be, ownerId is the whole access story.
     *
     * `read` covering `list` means a query is only allowed when Firestore can
     * prove statically that it returns nothing else — in practice the client
     * must always filter on `where('ownerId', '==', uid)`. An unfiltered
     * collection read fails rather than leaking.
     */
    match /courses/{courseId} {
      allow read: if owns(existing());

      allow create: if signedIn()
                    && owns(incoming())
                    && incoming().courseId == courseId
                    && isGameType(incoming().gameType)
                    && incoming().seeded is bool
                    // Every surface renders the title uppercase, and
                    // normaliseTitle() already stores it that way.
                    && incoming().title is string
                    && incoming().title.size() > 0
                    && incoming().title == incoming().title.upper()
                    && isServerTime('createdAt');

      allow update: if owns(existing())
                    && owns(incoming())
                    && unchanged('courseId')
                    && unchanged('createdAt')
                    && unchanged('seeded')
                    && isGameType(incoming().gameType)
                    && incoming().title == incoming().title.upper()
                    // The four shipped courses back the demo decks, so their
                    // titles cannot be renamed out from under them.
                    && (!existing().seeded || unchanged('title'));

      allow delete: if owns(existing()) && !existing().seeded;
    }

    /* ---------------------------------------------------------------- */
    /* decks/{deckId} and their cards                                    */
    /* ---------------------------------------------------------------- */

    match /decks/{deckId} {
      allow read: if owns(existing());

      allow create: if signedIn()
                    && owns(incoming())
                    && incoming().deckId == deckId
                    && incoming().courseId is string
                    && incoming().title is string
                    && incoming().sourceType in ['upload', 'manual']
                    // Provenance is null exactly when the deck was made by hand.
                    && (incoming().sourceType == 'manual'
                        ? incoming().uploadId == null
                        : incoming().uploadId is string)
                    && incoming().cardCount >= 0
                    && isServerTime('createdAt')
                    && isServerTime('updatedAt');

      allow update: if owns(existing())
                    && owns(incoming())
                    && unchanged('deckId')
                    && unchanged('createdAt')
                    && unchanged('sourceType')
                    && unchanged('uploadId')
                    && incoming().cardCount >= 0
                    && isServerTime('updatedAt');

      // Firestore does not cascade: the cards subcollection outlives this and
      // has to be swept by the client batch or a function.
      allow delete: if owns(existing());
    }

    /**
     * Cards carry no ownerId — the ERD keeps that fact on the deck alone, and
     * a copy here would be a fourth entry in its "deliberate duplication"
     * table. The cost is this get(): one billed read per rule evaluation,
     * paid on card reads and writes.
     *
     * If that ever shows up in the bill, denormalising ownerId onto the card
     * is the fix, and it is a schema change rather than a rules change.
     */
    match /decks/{deckId}/cards/{cardId} {
      function deckOwner() {
        return get(/databases/$(database)/documents/decks/$(deckId)).data.ownerId;
      }

      function ownsDeck() {
        return signedIn() && deckOwner() == request.auth.uid;
      }

      allow read: if ownsDeck();

      allow create: if ownsDeck()
                    && incoming().cardId == cardId
                    && incoming().deckId == deckId
                    && isGameType(incoming().gameType)
                    && incoming().difficulty >= 1
                    && incoming().difficulty <= 3
                    // The payload's shape varies by gameType and is validated
                    // by the extraction parser, which drops cards that break
                    // the per-template arity rules. Rules check the envelope.
                    && incoming().payload is map
                    && isServerTime('createdAt');

      allow update: if ownsDeck()
                    && unchanged('cardId')
                    && unchanged('deckId')
                    && unchanged('createdAt')
                    && isGameType(incoming().gameType)
                    && incoming().difficulty >= 1
                    && incoming().difficulty <= 3
                    && incoming().payload is map;

      allow delete: if ownsDeck();
    }

    /* ---------------------------------------------------------------- */
    /* uploads/{uploadId}                                                */
    /* ---------------------------------------------------------------- */

    /**
     * The job record for one extraction. The client creates it and then polls
     * it; the extraction function writes the outcome.
     *
     * A client can therefore only ever open a job that is honestly pending. It
     * cannot write `status: 'done'` with a deckId of its choosing, which is
     * what stops an upload being used to point at a deck it does not own.
     */
    match /uploads/{uploadId} {
      allow read: if owns(existing());

      allow create: if signedIn()
                    && owns(incoming())
                    && incoming().uploadId == uploadId
                    && incoming().fileName is string
                    && incoming().fileType in ['pdf', 'text']
                    // The exact object path storage.rules allows: one object
                    // per job, named after it. Firebase uids and these ids are
                    // alphanumeric, so the pattern needs no escaping.
                    && incoming().storagePath == 'uploads/' + request.auth.uid + '/' + uploadId
                    && incoming().status == 'processing'
                    && incoming().deckId == null
                    && incoming().errorMessage == null
                    && incoming().cardsGenerated == 0
                    && incoming().completedAt == null
                    && isServerTime('createdAt');

      // Owned by the extraction function, which bypasses rules.
      allow update: if false;

      // Dismissing a failed or finished job is the user's to do.
      allow delete: if owns(existing());
    }

    /* ---------------------------------------------------------------- */
    /* Default deny                                                      */
    /* ---------------------------------------------------------------- */

    // Anything not matched above. Explicit so a new collection added without
    // rules is closed rather than open.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
